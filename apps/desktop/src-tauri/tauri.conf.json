{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Video Workflow",
  "version": "0.1.0",
  "identifier": "com.local.aivideoworkflow",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AI Video Workflow",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "dmg",
    "externalBin": ["binaries/workflow-sidecar"]
  }
}
